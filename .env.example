# Copy this file to ".env" and fill in real values.
# ".env" itself must NEVER be committed to git (see .gitignore).

# ---- Django ----
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to dev everywhere. docker-compose.prod.yml overrides this to
# "config.settings.prod" directly (compose's "environment:" wins over
# "env_file:" for the same variable, so this value here only affects dev).
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---- PostgreSQL ----
# These same variables are read both by the "db" service (to initialize the
# database) and by Django's DATABASES setting (to connect to it).
POSTGRES_DB=bankmokamel
POSTGRES_USER=bankmokamel
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
